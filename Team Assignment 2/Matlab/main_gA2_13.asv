addXLabel(cg_type_cos_comp, 'Cancer Type');
addYLabel(cg_type_cos_comp, 'miRNA');
addTitle(cg_type_cos_comp, 'Hierarchical Clustering by Type: Cosine Distance + Complete Linkage');

